(FPCore determinant_dbl (a b c d e f g h i)
   :pre (<= 0.0 a 1000)
   :pre (<= 0.0 b 1000)
   :pre (<= 0.0 c 1000)
   :pre (<= 0.0 d 1000)
   :pre (<= 0.0 e 1000)
   :pre (<= 0.0 f 1000)
   :pre (<= 0.0 g 1000)
   :pre (<= 0.0 h 1000)
   :pre (<= 0.0 i 1000)
   (- (+ (+ (* (* a e) i) (* (* b f) g)) (* (* c d) h))
      (+ (+ (* (* c e) g) (* (* b d) i)) (* (* a f) h))))